# ====================================================
# H-RENT CAR 환경변수 예제 (실제 값은 .env 에 작성)
# ====================================================

# 데이터베이스
# 로컬 개발: SQLite
DATABASE_URL="file:./dev.db"
# 프로덕션(Vercel): Neon PostgreSQL 또는 Turso 권장
# DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# 어드민 로그인 — 반드시 강한 값으로 교체
ADMIN_PASSWORD="your-strong-password"
ADMIN_SESSION_SECRET="your-random-secret-at-least-32-chars"

# 상담 이메일 알림 (비워두면 DB 저장만 됨 — 알림 없음)
SMTP_HOST=""        # 예: smtp.gmail.com
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""        # 발신 이메일 주소
SMTP_PASS=""        # 이메일 비밀번호 또는 앱 비밀번호
EMAIL_TO=""         # 알림 수신 이메일 주소
