generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Car {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  category      String
  brand         String?
  thumbnail     String   @default("")
  images        String   @default("[]")
  monthlyPrice  Int
  deposit       String?
  contractTerms String?
  mileage       String?
  year          String?
  fuel          String?
  seats         Int?
  options       String?
  description   String?
  label         String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Inquiry {
  id            String   @id @default(cuid())
  name          String
  phone         String
  carInterest   String?
  type          String?
  message       String?
  status        String   @default("NEW")
  agreedPrivacy Boolean
  pickupDate    String?
  returnDate    String?
  pickupTime    String?
  returnTime    String?
  createdAt     DateTime @default(now())
}

model Banner {
  id         String   @id @default(cuid())
  chipLabel  String
  chipPrice  String
  caption    String?
  carType    String   @default("sedan")
  glow       String   @default("rgba(61,139,255,.28)")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  stars     Int      @default(5)
  text      String
  name      String
  detail    String?
  initial   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
