generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Car {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  slug          String?
  category      String
  brand         String?
  thumbnail     String   @default("")
  images        String   @default("[]")
  monthlyPrice  Int
  dailyPrice    Int?
  deposit       String?
  contractTerms String?
  mileage       String?
  year          String?
  fuel          String?
  seats         Int?
  options       String   @default("[]")
  rentalTypes   String   @default("[]")
  isFeatured    Boolean  @default(false)
  description   String?
  label         String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("hr_cars")
}

model Inquiry {
  id            String   @id @default(cuid())
  name          String
  phone         String
  carInterest   String?
  type          String?
  message       String?
  status        String   @default("NEW")
  agreedPrivacy Boolean
  createdAt     DateTime @default(now())

  @@map("hr_inquiries")
}

model Banner {
  id         String   @id @default(cuid())
  chipLabel  String
  chipPrice  String
  caption    String?
  imageUrl   String?
  carType    String   @default("sedan")
  glow       String   @default("rgba(61,139,255,.28)")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("hr_banners")
}

model Review {
  id        String   @id @default(cuid())
  stars     Int      @default(5)
  text      String
  name      String
  detail    String?
  initial   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("hr_reviews")
}

model Category {
  id        String @id @default(cuid())
  slug      String @unique
  label     String
  sortOrder Int    @default(0)

  @@map("hr_categories")
}

model RateCard {
  id            String   @id @default(cuid())
  name          String
  startingPrice Int?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("hr_rate_cards")
}

model SiteSetting {
  key   String @id
  value String @default("")

  @@map("hr_settings")
}
